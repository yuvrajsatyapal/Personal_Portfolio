{
  "name": "personal-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc -b && npm run typecheck:api && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "test": "vitest run",
    "typecheck": "tsc -b && npm run typecheck:api",
    "typecheck:api": "tsc -p tsconfig.api.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@vercel/analytics": "^2.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
