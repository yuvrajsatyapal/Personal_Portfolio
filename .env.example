# Server-only variables. Add these in Vercel Project Settings > Environment Variables.
# Create an access token at https://vercel.com/account/settings/tokens
VERCEL_ANALYTICS_TOKEN=
# Project Settings > General > Project ID
VERCEL_ANALYTICS_PROJECT_ID=
# Team Settings > General > Team ID. Leave empty for personal-account projects.
VERCEL_ANALYTICS_TEAM_ID=
